# CoThink provider configuration.
# Copy to `.env` and fill in — or export in your shell before `npm start`.
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: pick a model (default: openai/gpt-4o-mini)
# COTHINK_MODEL=openai/gpt-4o-mini

# Cross-check verifier model — deliberately a DIFFERENT family than the
# generator, so verification is independent (default: anthropic/claude-3.5-haiku)
# COTHINK_VERIFIER_MODEL=anthropic/claude-3.5-haiku

# Optional: server port (default 4175)
# PORT=4175
